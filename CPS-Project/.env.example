# Local development only. Copy to .env and set a strong random token.
ADMIN_PROVISIONING_TOKEN=
# Server-to-server Rasid read-only integration credential. Do not place this in browser configuration.
RASID_INTEGRATION_TOKEN=
# Separate server-to-server control credential. Phase 1B commands are
# non-actuating and require HTTPS; never expose this value to a browser.
RASID_CONTROL_TOKEN=
