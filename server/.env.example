# ===== Rasid AI server settings — copy to .env and edit =====

# Hugging Face token (optional, faster/authenticated model downloads)
HF_TOKEN=

# ---- Notifications (leave empty to disable a channel) ----
# Telegram: create a bot with @BotFather, add it to a group, put the token and chat id here
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional per-team groups (otherwise TELEGRAM_CHAT_ID is used)
TELEGRAM_CHAT_ID_MEDICAL=
TELEGRAM_CHAT_ID_CIVIL_DEFENSE=
TELEGRAM_CHAT_ID_ORGANIZERS=
# Any HTTP endpoint that receives the event as JSON (SMS gateway, n8n, Teams, your own system)
NOTIFY_WEBHOOK_URL=
# Also notify for detections found in uploaded recordings (default: dashboard only)
NOTIFY_RECORDED=0
# Address of this server as reachable by recipients (adds a snapshot link to messages)
RASID_PUBLIC_URL=

# ---- Detection tuning ----
# event starts when seen in START_HITS of the last WINDOW analyzed frames
RASID_EVENT_WINDOW=5
RASID_EVENT_START_HITS=3
# event ends after this many seconds without the detection
RASID_EVENT_END_AFTER_S=8
# minimum gap before a new event of the same kind on the same camera
RASID_EVENT_COOLDOWN_S=20
# max analysis rate per server-side stream (frames per second)
RASID_STREAM_MAX_FPS=4
# recorded videos are sampled at this rate
RASID_VIDEO_SAMPLE_FPS=2

# auto | yolo | lite   (lite = OpenCV only, no PyTorch)
RASID_DETECTOR=auto

# ---- OpenRouter (IoT gunshot microphone) ----
OPENROUTER_API_KEY=
OPENROUTER_GUNSHOT_MODEL=google/gemini-2.5-flash

# ---- CPS Integration (Local Development) ----
# NODE-04 is fixed by the read-only adapter; it is not configurable here.
CPS_INTEGRATION_DEVELOPMENT_MODE=1
CPS_INTEGRATION_BASE_URL=http://127.0.0.1:8001
CPS_RASID_INTEGRATION_TOKEN=
CPS_INTEGRATION_TIMEOUT_S=5

# ---- AI Threat & Abnormal Behavior Detection (server/threat) ----
# 0 turns the add-on off completely (existing analysis is not affected either way)
RASID_THREAT_ENABLED=1
# Telegram group of the security team (otherwise TELEGRAM_CHAT_ID is used)
TELEGRAM_CHAT_ID_SECURITY=
# weapons: YOLO confidence, and hits needed in the last N sampled frames (4 per second)
RASID_WEAPON_CONF=0.50
RASID_WEAPON_MIN_HITS=2
RASID_WEAPON_WINDOW=4
# gunshot / explosion sound (AST AudioSet scores 0..1; the class must also be in the top 3)
RASID_GUNSHOT_THRESHOLD=0.15
RASID_EXPLOSION_THRESHOLD=0.25
# violence (VideoMAE probability) and consecutive 2-second clips needed
RASID_VIOLENCE_THRESHOLD=0.85
RASID_VIOLENCE_MIN_HITS=2
# running: body-heights per second, sustained for RUN_MIN_S seconds
RASID_RUN_SPEED=1.6
RASID_RUN_MIN_S=0.5
# live cameras also analyzed for threats ("*" = all video cameras), rate, and VideoMAE on live video
RASID_THREAT_LIVE_CAMERAS=CAM-TH
RASID_THREAT_LIVE_FPS=5
RASID_THREAT_LIVE_VIOLENCE=1

# Monitor-only HVAC intelligence evidence freshness. These are not HVAC action thresholds.
OPERATIONAL_HVAC_CPS_FRESHNESS_S=30
OPERATIONAL_HVAC_AI_FRESHNESS_S=30
OPERATIONAL_HVAC_CAMERA_ID=CAM-C
OPERATIONAL_HVAC_TREND_LOOKBACK_S=300
# NODE-04 has one temperature sensor, so CPS can never peer-validate it as NORMAL.
OPERATIONAL_HVAC_ACCEPT_SINGLE_SENSOR=true
# Approved thresholds (match the ESP32 local fan control: setpoint 25 C, on at 26 C).
OPERATIONAL_HVAC_POLICY_APPROVED=true
OPERATIONAL_HVAC_REACTIVE_TEMPERATURE_C=26
OPERATIONAL_HVAC_NORMAL_TEMPERATURE_MAX_C=25
OPERATIONAL_HVAC_MINIMUM_TEMPERATURE_RISE_C=0.5
OPERATIONAL_HVAC_MINIMUM_CROWD_INCREASE=3
